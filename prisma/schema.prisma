// Expense Voucher Management System — Prisma schema (MySQL 8.0+).
// Authoritative table specification: DATABASE.md (local planning kit).
// UUIDs: CHAR(36) string UUIDs generated by Prisma (DECISIONS.md D-011).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Roles are stored as a MySQL ENUM via Prisma's enum mapping (documented in DATABASE.md §1).
enum UserRole {
  EMPLOYEE
  DIRECTOR
  ACCOUNTS
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  employeeCode String?   @unique @map("employee_code") @db.VarChar(50)
  department   String?   @db.VarChar(120)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
