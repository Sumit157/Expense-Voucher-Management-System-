# Copy to .env and fill in real values. Never commit .env.
# See docs/ENVIRONMENT.md for the variable contract.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — local MySQL 8.0+ (primary; see DECISIONS.md D-014).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://evoucher:change-me@127.0.0.1:3306/expense_voucher

# Trusted origins (CORS + cookies)
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# Session/auth secret — generate a long random value (Phase 2+)
SESSION_SECRET=change-me-to-a-long-random-string

# Private signature storage (must NOT be web-accessible)
UPLOAD_DIR=./uploads
MAX_SIGNATURE_BYTES=2097152

# Display timezone for "today" dashboard stats (see PHASE0.md A-009)
APP_TZ=UTC
