# Copy to .env and fill in real values. Never commit .env.
# See docs/ENVIRONMENT.md for the variable contract.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — local MySQL 8.0+ (primary; see DECISIONS.md D-014).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://evoucher:change-me@127.0.0.1:3306/expense_voucher

# Prisma shadow database used by `prisma migrate dev` (never by runtime).
# Must be a database the same user can fully control (DECISIONS.md D-021).
SHADOW_DATABASE_URL=mysql://evoucher:change-me@127.0.0.1:3306/expense_voucher_shadow

# Trusted origins (CORS + cookies)
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000

# Session/auth secret — generate a long random value (Phase 2+)
SESSION_SECRET=change-me-to-a-long-random-string
# Server-side session lifetime in hours (opaque cookie sessions; see DECISIONS.md D-018)
SESSION_TTL_HOURS=12

# Development-only password used by `npm run db:seed` (never reuse in production)
SEED_DEFAULT_PASSWORD=SeedDevPassword123!

# Optional override for the integration-test database
# (defaults to DATABASE_URL with the database name replaced by expense_voucher_test)
# TEST_DATABASE_URL=mysql://evoucher:password@127.0.0.1:3306/expense_voucher_test

# Private signature storage (must NOT be web-accessible)
UPLOAD_DIR=./uploads
MAX_SIGNATURE_BYTES=2097152

# Display timezone for "today" dashboard stats (see PHASE0.md A-009)
APP_TZ=UTC
